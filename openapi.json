{
  "openapi": "3.0.0",
  "info": {
    "title": "PTTracker API",
    "description": "PTTracker 资源分享平台 API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8890",
      "description": "本地开发服务器"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "用户登录",
        "tags": ["认证"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string", "description": "用户名" },
                  "password": { "type": "string" }
                },
                "required": ["username", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "integer" },
                        "email": { "type": "string" },
                        "username": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "用户注册",
        "tags": ["认证"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "username": { "type": "string" },
                  "password": { "type": "string" },
                  "verificationCode": { "type": "string", "description": "邮箱验证码" }
                },
                "required": ["email", "username", "password", "verificationCode"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "integer" },
                        "email": { "type": "string" },
                        "username": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/send-verification-code": {
      "post": {
        "summary": "发送邮箱验证码",
        "tags": ["认证"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "验证码发送成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "expiry": { "type": "integer", "description": "验证码过期时间（秒）" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/torrents": {
      "get": {
        "summary": "获取种子列表",
        "tags": ["种子"],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": { "type": "string" },
            "description": "分类筛选"
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 },
            "description": "页码"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 20 },
            "description": "每页数量"
          }
        ],
        "responses": {
          "200": {
            "description": "种子列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer" },
                          "title": { "type": "string" },
                          "category": { "type": "string" },
                          "size": { "type": "string" },
                          "seeders": { "type": "integer" },
                          "leechers": { "type": "integer" },
                          "rating": { "type": "number" },
                          "uploadDate": { "type": "string" }
                        }
                      }
                    },
                    "total": { "type": "integer" },
                    "page": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/torrents/{id}": {
      "get": {
        "summary": "获取种子详情",
        "tags": ["种子"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "种子ID"
          }
        ],
        "responses": {
          "200": {
            "description": "种子详情",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer" },
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "category": { "type": "string" },
                    "size": { "type": "string" },
                    "seeders": { "type": "integer" },
                    "leechers": { "type": "integer" },
                    "rating": { "type": "number" },
                    "uploadDate": { "type": "string" },
                    "magnetLink": { "type": "string" },
                    "thumbnail": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Torrent": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "size": { "type": "string" },
          "seeders": { "type": "integer" },
          "leechers": { "type": "integer" },
          "rating": { "type": "number" },
          "uploadDate": { "type": "string" },
          "thumbnail": { "type": "string" }
        }
      }
    }
  }
}